{
  "name": "voice-coder",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "pnpm --filter bridge start",
    "build": "pnpm --filter web build",
    "dev:web": "pnpm --filter web dev",
